     "noname": true,
     "at": 24.16,
     "dur": 2.26,
     "text": "lalu menaruh bukunya. Rapi."
    },
    {
     "who": "narator",
     "noname": true,
     "at": 26.99,
     "dur": 2.12,
     "text": "Bu Sari membuka buku itu."
    },
    {
     "who": "narator",
     "noname": true,
     "at": 29.49,
     "dur": 2.78,
     "text": "PR-nya lengkap... tapi penuh cap kaki kucing."
    },
    {
     "who": "narator",
     "noname": true,
     "at": 32.6,
     "dur": 1.36,
     "text": "Bu Sari mengambil pulpen merah."
    },
    {
