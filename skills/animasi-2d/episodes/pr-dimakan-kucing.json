     "who": "narator",
     "noname": true,
     "at": 0.13,
     "dur": 1.58,
     "text": "Di kelas, Bu Sari berkata,"
    },
    {
     "who": "narator",
     "noname": true,
     "at": 2.07,
     "dur": 1.89,
     "text": "“Anak-anak, kumpulkan PR kalian!”"
    },
