     "who": "narator",
     "noname": true,
     "at": 6.95,
     "dur": 4.21,
     "text": "“Bu... PR saya... dibawa kucing!”"
    },
    {
     "who": "narator",
     "noname": true,
     "at": 11.6,
     "dur": 1.04,
     "text": "Satu kelas tertawa."
