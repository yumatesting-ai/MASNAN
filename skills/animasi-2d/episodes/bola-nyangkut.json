   "dialog": [
    {
     "who": "narator",
     "noname": true,
     "at": 0.23,
     "dur": 2.6,
     "text": "Siang itu Bima nendang bola sekuat tenaga."
    },
    {
     "who": "narator",
     "noname": true,
     "at": 3.6,
     "dur": 0.2,
     "text": "DUAK!"
    },
    {
     "who": "narator",
     "noname": true,
     "at": 4.77,
     "dur": 3.73,
     "text": "Bolanya terbang tinggi-tinggi dan nyangkut di pohon mangga."
    },
    {
     "who": "narator",
     "noname": true,
     "at": 9.3,
     "dur": 2.03,
     "text": "Pak Hasan lewat, langsung busungin dada."
    },
    {
     "who": "narator",
     "noname": true,
     "at": 12.07,
     "dur": 3.3,
     "text": "“Tenang, serahkan sama ahlinya!” Beliau copot sandal,"
    },
    {
     "who": "narator",
     "noname": true,
     "at": 15.77,
     "dur": 1.06,
     "text": "ancang-ancang, lempar!"
    },
    {
     "who": "narator",
     "noname": true,
     "at": 17.9,
     "dur": 0.63,
     "text": "Sandalnya nyangkut."
    },
    {
     "who": "narator",
     "noname": true,
     "at": 19.33,
     "dur": 1.97,
     "text": "Lempar sandal satunya lagi, nyangkut juga."
    },
    {
     "who": "narator",
     "noname": true,
     "at": 22.13,
     "dur": 0.97,
     "text": "Pak Hasan pinjem sapu Bu Atin."
    },
    {
     "who": "narator",
     "noname": true,
     "at": 23.8,
     "dur": 0.97,
     "text": "Lempar, nyangkut."
    },
    {
     "who": "narator",
     "noname": true,
     "at": 25.53,
     "dur": 1.87,
     "text": "Pinjem ember, lempar, nyangkut."
    },
    {
     "who": "narator",
     "noname": true,
     "at": 28.07,
     "dur": 1.96,
     "text": "Ember sama sapunya malah pelukan di atas."
    },
    {
     "who": "narator",
     "noname": true,
     "at": 30.87,
     "dur": 1.53,
     "text": "Lalu datang si Oyen, kucing warung."
    },
    {
     "who": "narator",
     "noname": true,
     "at": 33.07,
     "dur": 2.56,
     "text": "Dia manjat mau bantu, dan Oyen ikut nyangkut."
    },
    {
     "who": "narator",
     "noname": true,
     "at": 36.43,
     "dur": 4.4,
     "text": "“Meong!” Sekarang pohon mangga itu berbuah bola, sandal,"
    },
    {
     "who": "narator",
     "noname": true,
     "at": 41.23,
     "dur": 1.74,
     "text": "sapu, ember, dan kucing."
    },
    {
     "who": "narator",
     "noname": true,
     "at": 43.93,
     "dur": 0.54,
     "text": "Lalu datang Nana."
    },
    {
     "who": "narator",
     "noname": true,
     "at": 45.2,
     "dur": 2.97,
     "text": "Dia pegang pohonnya terus bilang, “Permisi ya, pohon.”"
    },
    {
     "who": "narator",
     "noname": true,
     "at": 48.57,
     "dur": 0.43,
     "text": "Goyang sedikit."
    },
    {
     "who": "narator",
     "noname": true,
     "at": 49.67,
     "dur": 0.3,
     "text": "Bola jatuh!"
    },
    {
     "who": "narator",
     "noname": true,
     "at": 50.67,
     "dur": 0.2,
     "text": "TUK!"
    },
    {
     "who": "narator",
     "noname": true,
     "at": 51.23,
     "dur": 0.97,
     "text": "Sandal, PLOK, PLOK!"
    },
    {
     "who": "narator",
     "noname": true,
     "at": 52.97,
     "dur": 0.6,
     "text": "Sapu, SREK!"
    },
    {
     "who": "narator",
     "noname": true,
     "at": 54.27,
     "dur": 0.86,
     "text": "Ember, KONTANG!"
    },
    {
     "who": "narator",
     "noname": true,
     "at": 55.83,
     "dur": 0.97,
     "text": "Dan terakhir... Oyen."
    },
    {
     "who": "narator",
     "noname": true,
     "at": 57.5,
     "dur": 0.2,
     "text": "HAP!"
    },
    {
     "who": "narator",
     "noname": true,
     "at": 57.93,
     "dur": 2.27,
     "text": "Mendarat pas di kepala Pak Hasan, kayak topi."
    },
    {
     "who": "narator",
     "noname": true,
     "at": 61.03,
     "dur": 0.44,
     "text": "Bu Atin datang."
    },
    {
     "who": "narator",
     "noname": true,
     "at": 62.17,
     "dur": 3.06,
     "text": "“Pak, ember saya kok penyok?” Pak Hasan cuma nunjuk Oyen."
    },
    {
     "who": "narator",
     "noname": true,
     "at": 65.93,
     "dur": 0.77,
     "text": "Oyen pura-pura tidur."
    },
    {
     "who": "hasan",
     "nosub": true,
     "emo": "proud",
     "at": 12.07,
     "dur": 1.83,
     "text": "Tenang, serahkan sama ahlinya!"
    },
    {
     "who": "nana",
     "nosub": true,
     "emo": "happy",
     "at": 47.1,
     "dur": 1.35,
     "text": "Permisi ya, pohon."
    },
    {
     "who": "atin",
     "nosub": true,
     "emo": "badmood",
     "at": 62.17,
     "dur": 1.88,
     "text": "Pak, ember saya kok penyok?"
    }
   ],
